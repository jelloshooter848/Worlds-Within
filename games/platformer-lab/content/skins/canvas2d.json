{
  "backend": "canvas2d",
  "background": "#5c94fc",
  "sheets": { "sheet": "lab-placeholders", "fallbackColor": "#fcfcfc" },
  "kinds": {
    "runner": {
      "frames": {
        "idle": { "right": "runner-idle" },
        "walk": { "right": { "frames": ["runner-walk-0", "runner-walk-1"], "ticks": 6 } },
        "run": { "right": { "frames": ["runner-walk-0", "runner-walk-1"], "ticks": 3 } },
        "skid": { "right": "runner-skid" },
        "jump": { "right": "runner-jump" },
        "fall": { "right": "runner-fall" },
        "hurt": { "right": "runner-hurt" },
        "dead": "runner-dead"
      },
      "flipFacing": true,
      "fallbackColor": "#d82800"
    },
    "walker": {
      "frames": {
        "idle": "walker-0",
        "walk": { "frames": ["walker-0", "walker-1"], "ticks": 8 },
        "run": { "frames": ["walker-0", "walker-1"], "ticks": 4 },
        "fall": "walker-0",
        "stomped": "walker-flat",
        "dead": "walker-dead"
      },
      "flipFacing": true,
      "fallbackColor": "#d82800"
    },
    "ledge-walker": {
      "frames": {
        "idle": "ledge-walker-0",
        "walk": { "frames": ["ledge-walker-0", "ledge-walker-1"], "ticks": 8 },
        "run": { "frames": ["ledge-walker-0", "ledge-walker-1"], "ticks": 4 },
        "fall": "ledge-walker-0",
        "stomped": "ledge-walker-flat",
        "dead": "ledge-walker-dead"
      },
      "flipFacing": true,
      "fallbackColor": "#9878f8"
    },
    "shell-walker": {
      "frames": {
        "idle": "shell-walker-0",
        "walk": { "frames": ["shell-walker-0", "shell-walker-1"], "ticks": 8 },
        "run": { "frames": ["shell-walker-0", "shell-walker-1"], "ticks": 4 },
        "fall": "shell-walker-0",
        "stomped": "shell-walker-0",
        "dead": "shell-walker-dead"
      },
      "flipFacing": true,
      "fallbackColor": "#00a800"
    },
    "shell": {
      "frames": {
        "idle": "shell",
        "walk": "shell",
        "run": { "frames": ["shell", "shell-spin"], "ticks": 3 },
        "fall": "shell",
        "stomped": "shell",
        "dead": "shell-dead"
      },
      "fallbackColor": "#00a800"
    },
    "coin": { "frames": { "idle": "coin", "pop": "coin" }, "fallbackColor": "#f8d800" },
    "goal": { "frames": { "idle": "goal" }, "fallbackColor": "#00a800" },
    "trigger": { "frames": { "idle": "trigger" }, "fallbackColor": "#9878f8" },
    "checkpoint": {
      "frames": { "idle": "checkpoint" },
      "fallbackColor": "#7c7c7c",
      "byTag": [{ "tag": "active", "frames": { "idle": "checkpoint-on" }, "fallbackColor": "#d82800" }]
    },
    "bump-block": { "frames": { "bump": "used" }, "fallbackColor": "#fc9838" },
    "bar-cell": { "frames": { "idle": "bar-cell", "zone": "bar-zone" }, "fallbackColor": "#bcbcbc" },
    "bar-marker": {
      "frames": {
        "idle": "bar-marker",
        "pass": "bar-marker-pass",
        "fail": "bar-marker-fail",
        "quit": "bar-marker"
      },
      "fallbackColor": "#f8d800"
    }
  },
  "tiles": {
    ".": { "frame": "sky", "fallbackColor": "#5c94fc" },
    "#": { "frame": "ground", "fallbackColor": "#c84c0c" },
    "B": { "frame": "brick", "fallbackColor": "#c84c0c" },
    "?": { "frame": "bump", "fallbackColor": "#fc9838" },
    "u": { "frame": "used", "fallbackColor": "#883c00" },
    "=": { "frame": "one-way", "fallbackColor": "#00a800" },
    "^": { "frame": "hazard", "fallbackColor": "#bcbcbc" }
  },
  "events": {
    "jump": {},
    "land": { "effect": { "kind": "particles", "color": "#fcbcb0", "count": 3, "size": 1, "ticks": 6 } },
    "bump": { "effect": { "kind": "shake", "size": 1, "ticks": 4 } },
    "block": { "effect": { "kind": "particles", "color": "#f8d800", "count": 4, "size": 1 } },
    "break": { "effect": { "kind": "particles", "color": "#c84c0c", "count": 8, "size": 2, "ticks": 16 } },
    "coin": { "effect": { "kind": "particles", "color": "#f8d800", "count": 5, "size": 1 } },
    "spawn": { "effect": { "kind": "particles", "color": "#fcfcfc", "count": 4, "size": 1 } },
    "stomp": { "effect": { "kind": "particles", "color": "#fcfcfc", "count": 6, "size": 1 } },
    "kick": { "effect": { "kind": "particles", "color": "#fcfcfc", "count": 3, "size": 1 } },
    "defeat": { "effect": { "kind": "particles", "color": "#d82800", "count": 6, "size": 1 } },
    "hurt": { "effect": { "kind": "flash", "color": "#d82800", "ticks": 2 } },
    "died": { "effect": { "kind": "shake", "size": 3, "ticks": 12 } },
    "respawn": { "effect": { "kind": "particles", "color": "#fcfcfc", "count": 8, "size": 1 } },
    "checkpoint": { "effect": { "kind": "particles", "color": "#d82800", "count": 6, "size": 1 } },
    "cleared": { "effect": { "kind": "tint", "color": "#f8d800", "ticks": 20 } },
    "mini-game": { "effect": { "kind": "flash", "color": "#fcfcfc", "ticks": 2 } },
    "mini-game-end": { "effect": { "kind": "tint", "color": "#9878f8", "ticks": 10 } }
  },
  "hud": [
    { "status": "hp", "as": "hearts", "x": 8, "y": 8, "frame": "heart" },
    { "status": "coins", "as": "icon", "x": 40, "y": 8, "frame": "hud-coin" },
    { "status": "coins", "as": "number", "x": 50, "y": 8, "font": "lab-font" },
    { "status": "lives", "as": "icon", "x": 80, "y": 8, "frame": "hud-life" },
    { "status": "lives", "as": "number", "x": 90, "y": 8, "font": "lab-font" }
  ],
  "camera": { "follow": "runner", "deadzone": { "w": 32, "h": 48 }, "lerp": 0.25 }
}

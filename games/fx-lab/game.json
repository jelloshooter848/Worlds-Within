{
  "id": "fx-lab",
  "title": "The fx lab: two short levels on the platformer kit that show every presentation feature, in 2D and 3D",
  "kit": "platformer",
  "content": {
    "level": ["content/levels/*.json"],
    "campaign": ["content/campaigns/*.campaign.json"],
    "profile": ["content/profiles/*.profile.json"],
    "palette": ["content/palettes/*.json"],
    "sprite": ["content/sprites/*.txt"],
    "font": ["content/fonts/*.txt"],
    "ui": ["content/ui/*.json"],
    "skin": ["content/skins/*.json"],
    "sfx": ["content/sfx/*.json"],
    "song": ["content/songs/*.json"]
  },
  "start": {
    "seed": 1
  },
  "screen": {
    "width": 256,
    "height": 240
  },
  "transitions": {
    "level": {
      "kind": "iris",
      "ticks": 28,
      "hold": 8,
      "ease": "cubicIn",
      "at": "follow"
    },
    "scene": {
      "kind": "fade",
      "ticks": 12
    },
    "default": {
      "kind": "fade",
      "ticks": 16,
      "hold": 4
    }
  },
  "headless": "headless.ts",
  "view": "view.ts"
}

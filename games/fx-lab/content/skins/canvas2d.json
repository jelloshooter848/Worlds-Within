{
  "backend": "canvas2d",
  "background": "#6888fc",
  "sheets": {
    "sheet": "fx",
    "fallbackColor": "#ff00ff"
  },
  "images": {
    "lab-torch": {
      "image": "assets/fx-lab-png/torch.png",
      "frameSize": {
        "w": 16,
        "h": 24
      },
      "grid": {
        "cols": 4,
        "rows": 1,
        "margin": 1,
        "spacing": 2
      },
      "names": ["torch-0", "torch-1", "torch-2", "torch-3"],
      "frames": {
        "torch-unlit": {
          "x": 1,
          "y": 27,
          "w": 16,
          "h": 24
        }
      },
      "anchor": "bottom"
    }
  },
  "kinds": {
    "runner": {
      "flipFacing": true,
      "size": {
        "w": 16,
        "h": 16
      },
      "offset": {
        "x": -2,
        "y": 0
      },
      "frames": {
        "idle": {
          "right": {
            "frames": ["pip-settle", "pip-idle-0"],
            "ticks": [5, 1],
            "loop": false,
            "then": "breathe"
          }
        },
        "breathe": {
          "right": {
            "frames": ["pip-idle-0", "pip-idle-1", "pip-idle-0", "pip-blink", "pip-idle-0", "pip-idle-1"],
            "ticks": [30, 24, 30, 4, 20, 24]
          }
        },
        "walk": {
          "right": {
            "frames": ["pip-walk-0", "pip-walk-1", "pip-walk-2", "pip-walk-3"],
            "ticks": [7, 5, 7, 5],
            "events": {
              "0": "footstep",
              "2": "footstep"
            }
          }
        },
        "run": {
          "right": {
            "frames": ["pip-run-0", "pip-run-1", "pip-run-2", "pip-run-3"],
            "ticks": [4, 3, 4, 3],
            "events": {
              "0": "footstep",
              "2": "footstep"
            }
          }
        },
        "skid": {
          "right": {
            "frames": ["pip-skid"],
            "events": {
              "0": "skid-dust"
            }
          }
        },
        "jump": {
          "right": {
            "frames": ["pip-jump-0", "pip-jump-1"],
            "ticks": [3, 1],
            "loop": false
          }
        },
        "fall": {
          "right": {
            "frames": ["pip-fall-0", "pip-fall-1"],
            "ticks": [5, 5]
          }
        },
        "hurt": {
          "right": {
            "frames": ["pip-hurt-1", "pip-hurt-0", "pip-hurt-1", "pip-hurt-0"],
            "ticks": [2, 2, 2, 6],
            "loop": false
          }
        },
        "dead": {
          "frames": ["pip-dead-0", "pip-dead-1", "pip-dead-2"],
          "ticks": [10, 6, 6],
          "loop": false,
          "events": {
            "1": "tumble"
          }
        }
      }
    },
    "beetle": {
      "flipFacing": true,
      "frames": {
        "idle": "beetle-0",
        "walk": {
          "frames": ["beetle-0", "beetle-1"],
          "ticks": [6, 6],
          "events": {
            "0": "scuttle"
          }
        },
        "run": {
          "frames": ["beetle-0", "beetle-1"],
          "ticks": 3
        },
        "fall": "beetle-1",
        "stomped": {
          "frames": ["beetle-flat"],
          "ticks": 1,
          "loop": false
        },
        "dead": "beetle-dead"
      }
    },
    "coin": {
      "frames": {
        "idle": {
          "frames": ["coin-0", "coin-1", "coin-2", "coin-3"],
          "ticks": [24, 4, 3, 4]
        },
        "pop": {
          "frames": ["coin-0", "coin-1", "coin-2", "coin-3"],
          "ticks": 2
        }
      },
      "glow": {
        "color": "#f8b800",
        "radius": 3
      }
    },
    "goal": {
      "size": {
        "w": 16,
        "h": 32
      },
      "offset": {
        "x": 0,
        "y": -16
      },
      "frames": {
        "idle": {
          "frames": ["door", "door-glow", "door", "door-lit"],
          "ticks": [40, 6, 20, 6]
        }
      },
      "emit": "magic-aura",
      "glow": {
        "color": "#a4e4fc",
        "radius": 6
      }
    },
    "bump-block": {
      "frames": {
        "bump": "used"
      },
      "byTag": [
        {
          "tag": "brick",
          "frames": {
            "bump": "brick"
          }
        }
      ]
    },
    "torch": {
      "sheet": "lab-torch",
      "frames": {
        "idle": {
          "frames": ["torch-0", "torch-1", "torch-2", "torch-3"],
          "ticks": [6, 5, 7, 5]
        }
      },
      "emit": ["torch-smoke", "torch-flame"],
      "glow": {
        "color": "#f87858",
        "radius": 5
      }
    }
  },
  "tiles": {
    "#": {
      "frame": "ground"
    },
    "B": {
      "frame": "brick"
    },
    "?": {
      "frame": "bump"
    },
    "u": {
      "frame": "used"
    },
    "=": {
      "frame": "one-way"
    },
    "^": {
      "frame": "hazard"
    }
  },
  "events": {
    "footstep": {
      "sound": "footstep",
      "emit": ["run-dust"],
      "pitch": [-2, 1.5],
      "volume": [0.6, 1],
      "cooldown": 4
    },
    "skid-dust": {
      "sound": "land",
      "emit": ["run-dust", "land-dust"]
    },
    "tumble": {
      "sound": "whoosh"
    },
    "scuttle": {},
    "jump": {
      "sound": "jump",
      "tween": {
        "prop": "scaleY",
        "from": 1.25,
        "to": 1,
        "frames": 6,
        "ease": "quadOut"
      },
      "pitch": [-1, 1],
      "volume": [0.8, 1]
    },
    "land": {
      "sound": "land",
      "emit": ["land-dust"],
      "tween": {
        "prop": "scaleY",
        "from": 0.75,
        "to": 1,
        "frames": 6,
        "ease": "backOut"
      }
    },
    "bump": {
      "sound": "bump",
      "effect": {
        "kind": "shake",
        "size": 1,
        "ticks": 4
      }
    },
    "block": {
      "effect": {
        "kind": "particles",
        "color": "#f8b800",
        "count": 4,
        "size": 1
      }
    },
    "break": {
      "sound": "stomp",
      "effect": {
        "kind": "particles",
        "color": "#c84c0c",
        "count": 8,
        "size": 2,
        "ticks": 16
      }
    },
    "coin": {
      "sound": "coin",
      "emit": ["coin-burst", "coin-glint"]
    },
    "stomp": {
      "sound": "stomp",
      "emit": ["stomp-sparks", "stomp-ring"],
      "shake": {
        "amount": 3,
        "ticks": 14
      },
      "hitPause": {
        "ticks": 4
      },
      "duck": {
        "amount": 0.6,
        "attack": 2,
        "hold": 10,
        "release": 24
      }
    },
    "defeat": {
      "effect": {
        "kind": "particles",
        "color": "#d82800",
        "count": 6,
        "size": 1
      }
    },
    "hurt": {
      "sound": "hurt",
      "flash": {
        "color": "#d82800",
        "alpha": 0.6,
        "ticks": 8
      },
      "duck": {
        "amount": 0.5,
        "attack": 2,
        "hold": 6,
        "release": 20
      }
    },
    "died": {
      "sound": "fail",
      "shake": {
        "amount": 5,
        "ticks": 24
      }
    },
    "respawn": {
      "effect": {
        "kind": "particles",
        "color": "#fcfcfc",
        "count": 8,
        "size": 1
      }
    },
    "cleared": {
      "sound": "door",
      "effect": {
        "kind": "tint",
        "color": "#f8b800",
        "ticks": 20
      },
      "zoom": {
        "to": 1.5,
        "ticks": 12,
        "ease": "cubicOut",
        "hold": 30,
        "back": 18
      }
    }
  },
  "hud": [
    {
      "as": "panel",
      "x": 4,
      "y": 4,
      "w": 112,
      "h": 32,
      "frame": "hud-panel",
      "slice": 2
    },
    {
      "as": "text",
      "x": 10,
      "y": 9,
      "font": "fx-small",
      "format": "Pip",
      "color": "#fcfcfc",
      "shadow": "#000000"
    },
    {
      "status": "hp",
      "as": "bar",
      "x": 30,
      "y": 9,
      "w": 56,
      "h": 8,
      "max": "maxHp",
      "color": "#00a800",
      "back": "#000000",
      "low": {
        "below": 0.34,
        "color": "#d82800"
      },
      "panel": {
        "frame": "bar-frame",
        "slice": 2
      }
    },
    {
      "status": "coins",
      "as": "counter",
      "x": 10,
      "y": 22,
      "frame": "hud-coin",
      "font": "fx-small",
      "digits": 2,
      "color": "#f8b800",
      "shadow": "#000000",
      "tween": {
        "ticks": 24,
        "color": "#fcfcfc"
      }
    },
    {
      "status": "lives",
      "as": "counter",
      "x": 46,
      "y": 22,
      "frame": "hud-life",
      "font": "fx-small",
      "format": "x{value}",
      "color": "#fcfcfc",
      "shadow": "#000000"
    },
    {
      "as": "panel",
      "x": 166,
      "y": 14,
      "w": 88,
      "h": 38,
      "frame": "hud-panel",
      "slice": 2
    },
    {
      "as": "text",
      "x": 0,
      "y": 82,
      "w": 256,
      "align": "center",
      "font": "fx-small",
      "format": "Stomp beetles, grab coins & find the door!",
      "color": "#fcfcfc",
      "shadow": "#000000"
    },
    {
      "as": "minimap",
      "x": 170,
      "y": 18,
      "w": 80,
      "h": 30,
      "scale": 2,
      "tiles": {
        "#": "#00a800",
        "=": "#fce0a8",
        "?": "#f8b800",
        "B": "#c84c0c",
        "u": "#7c7c7c",
        "^": "#bcbcbc"
      },
      "back": "#005858",
      "dots": [
        {
          "kind": "runner",
          "color": "#fcfcfc",
          "size": 3
        },
        {
          "kind": "coin",
          "color": "#f8b800",
          "size": 2
        },
        {
          "kind": "beetle",
          "color": "#d82800",
          "size": 2
        },
        {
          "kind": "goal",
          "color": "#a4e4fc",
          "size": 2
        }
      ]
    },
    {
      "as": "text",
      "x": 0,
      "y": 62,
      "w": 256,
      "align": "center",
      "font": "fx-title",
      "format": "The Fx Lab",
      "color": "#fcfcfc",
      "outline": "#000000"
    }
  ],
  "camera": {
    "follow": "runner",
    "deadzone": {
      "w": 32,
      "h": 48
    },
    "lerp": 0.25,
    "lookAhead": {
      "x": 24,
      "lerp": 0.08
    }
  },
  "emitters": {
    "land-dust": {
      "burst": 10,
      "life": [14, 22],
      "speed": [0.5, 1.4],
      "angle": [182, 358],
      "anchor": "feet",
      "offset": {
        "x": 0,
        "y": -1
      },
      "shape": {
        "box": {
          "w": 10,
          "h": 1
        }
      },
      "gravity": 0.02,
      "drag": 0.1,
      "size": [2, 4, 4, 2],
      "color": ["#fce0a8", "#bcbcbc"],
      "alpha": [1, 0.8, 0]
    },
    "run-dust": {
      "burst": 2,
      "life": [12, 18],
      "speed": [0.15, 0.45],
      "angle": [225, 315],
      "gravity": -0.012,
      "drag": 0.05,
      "shape": {
        "box": {
          "w": 6,
          "h": 1
        }
      },
      "size": [2, 3, 3],
      "color": ["#fce0a8", "#bcbcbc"],
      "alpha": [0.85, 0]
    },
    "stomp-sparks": {
      "burst": 14,
      "life": [12, 20],
      "speed": [1.2, 2.6],
      "angle": [190, 350],
      "gravity": 0.14,
      "drag": 0.04,
      "size": [2, 2, 1],
      "color": ["#fcfcfc", "#f8b800", "#d82800"],
      "alpha": [
        {
          "at": 0,
          "value": 1
        },
        {
          "at": 0.6,
          "value": 1
        },
        {
          "at": 1,
          "value": 0
        }
      ],
      "glow": 2
    },
    "stomp-ring": {
      "burst": 12,
      "life": 9,
      "speed": 2,
      "angle": [0, 360],
      "even": true,
      "drag": 0.22,
      "size": [2, 1],
      "color": "#fcfcfc",
      "alpha": [0.7, 0],
      "blend": "add"
    },
    "torch-flame": {
      "rate": 0.8,
      "life": [8, 14],
      "speed": [0.25, 0.6],
      "angle": [255, 285],
      "shape": {
        "circle": 2
      },
      "anchor": "top",
      "offset": {
        "x": 0,
        "y": 6
      },
      "gravity": -0.02,
      "size": [3, 3, 1],
      "color": ["#fce0a8", "#f8b800", "#d82800"],
      "alpha": [1, 0.9, 0],
      "glow": 4
    },
    "torch-smoke": {
      "rate": 0.25,
      "life": [36, 52],
      "speed": [0.2, 0.4],
      "angle": [262, 278],
      "anchor": "top",
      "offset": {
        "x": 0,
        "y": 2
      },
      "gravity": -0.004,
      "drag": 0.01,
      "size": [2, 4, 7],
      "color": ["#7c7c7c", "#bcbcbc"],
      "alpha": [
        {
          "at": 0,
          "value": 0
        },
        {
          "at": 0.15,
          "value": 0.55
        },
        {
          "at": 1,
          "value": 0
        }
      ]
    },
    "coin-burst": {
      "burst": 10,
      "life": [12, 18],
      "speed": [1.2, 2.2],
      "angle": [0, 360],
      "drag": 0.1,
      "gravity": 0.06,
      "size": [2, 2, 1],
      "color": ["#fce0a8", "#f8b800", "#ac7c00"],
      "alpha": [1, 1, 0],
      "glow": 2
    },
    "coin-glint": {
      "burst": 3,
      "life": [18, 26],
      "speed": [0.3, 0.6],
      "angle": [245, 295],
      "shape": {
        "circle": 5
      },
      "frame": "sparkle",
      "size": [1, 1, 1],
      "alpha": [1, 1, 0],
      "blend": "add"
    },
    "magic-aura": {
      "rate": 1,
      "life": [30, 48],
      "speed": [0.1, 0.3],
      "angle": [258, 282],
      "shape": {
        "box": {
          "w": 20,
          "h": 32
        }
      },
      "gravity": -0.004,
      "size": [2, 2, 2, 1],
      "color": ["#fcfcfc", "#a4e4fc", "#00a8a8"],
      "alpha": [
        {
          "at": 0,
          "value": 0
        },
        {
          "at": 0.2,
          "value": 1
        },
        {
          "at": 1,
          "value": 0
        }
      ],
      "glow": 3
    }
  },
  "parallax": [
    {
      "gradient": ["#3058e8", "#3cbcfc", "#a4e4fc"],
      "bands": 12,
      "factor": 0
    },
    {
      "frame": "clouds",
      "sheet": "fx-sky",
      "factor": {
        "x": 0.1,
        "y": 0
      },
      "y": 24,
      "depth": 900
    },
    {
      "frame": "mountains",
      "sheet": "fx-sky",
      "factor": {
        "x": 0.25,
        "y": 0.05
      },
      "y": 116,
      "depth": 600
    },
    {
      "frame": "hills",
      "sheet": "fx-sky",
      "factor": {
        "x": 0.5,
        "y": 0.1
      },
      "y": 172,
      "depth": 300
    }
  ],
  "music": {
    "lab": {
      "layers": {
        "calm": "lab-calm",
        "danger": "lab-danger"
      },
      "fade": 30,
      "mix": [
        {
          "when": {
            "status": "nearestActor",
            "gte": 0,
            "lt": 72
          },
          "layers": {
            "calm": 0.3,
            "danger": 1
          },
          "fade": 12
        },
        {
          "layers": {
            "calm": 1,
            "danger": 0
          }
        }
      ]
    }
  }
}

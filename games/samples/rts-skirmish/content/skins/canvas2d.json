      "effect": {
        "kind": "flash",
        "color": "#fcfcfc",
        "ticks": 2
      }
    },
    "building-hit:side=own": {
      "sound": "clash"
    },
    "stock-up:side=own": {
      "sound": "coin"
    },
    "battle-end:won": {
      "sound": "victory",
      "effect": {
        "kind": "tint",
        "color": "#f8b800",
        "ticks": 20
      }
    },
    "battle-end:lost": {
      "sound": "defeat",
      "effect": {
        "kind": "tint",
        "color": "#a80020",
        "ticks": 20
      }
    }

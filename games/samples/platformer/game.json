{
  "id": "platformer",
  "title": "The platformer sample, Hopper's Way: the flagship platformer (Engine 0.16 part B), three levels and a mini-boss on the platformer kit, in 2D and 2.5D",
  "kit": "platformer",
  "content": {
    "level": ["content/levels/*.json"],
    "campaign": ["content/campaigns/*.campaign.json"],
    "profile": ["content/profiles/*.profile.json"],
    "palette": ["content/palettes/*.json"],
    "sprite": ["content/sprites/*.txt"],
    "skin": ["content/skins/*.json"],
    "sfx": ["content/sfx/*.json"],
    "song": ["content/songs/*.json"],
    "font": ["content/fonts/*.txt"]
  },
  "start": {
    "seed": 1
  },
  "screen": {
    "width": 320,
    "height": 180
  },
  "transitions": {
    "level": {
      "kind": "fade",
      "ticks": 20,
      "hold": 6
    },
    "respawn": {
      "kind": "iris",
      "ticks": 16,
      "hold": 6,
      "ease": "quadIn",
      "at": "follow"
    }
  },
  "menus": {
    "font": "hopper-small",
    "titleFont": "hopper-title",
    "style": {
      "text": "#fcf4e0",
      "shadow": "#2a1a12",
      "focusText": "#ffe060",
      "disabledText": "#9a8a7a",
      "back": "#211f30",
      "focusBack": "#4e8a2e",
      "border": "#f4ead8",
      "track": "#4a3a30",
      "fill": "#7cc84a",
      "panel": {
        "sheet": "terrain",
        "frame": "hud-panel",
        "slice": 16
      },
      "cursor": ">",
      "padding": 2,
      "gap": 2,
      "sounds": {
        "move": "ui-move",
        "select": "ui-select",
        "back": "ui-back"
      },
      "heading": "#ffe060",
      "outline": "#2a1a12",
      "dim": 0.55,
      "dimColor": "#10142a"
    },
    "title": {
      "name": "Hopper's Way",
      "subtitle": "A frog's run through the long meadow",
      "art": [
        {
          "sheet": "frog-idle",
          "frame": "idle-0",
          "scale": 3,
          "anchor": "left",
          "x": 22,
          "y": 6
        },
        {
          "sheet": "critters",
          "frame": "blob-0",
          "scale": 2,
          "anchor": "right",
          "x": 44,
          "y": 34
        }
      ],
      "music": "meadow",
      "items": ["start", "levels", "controls", "settings"],
      "dim": 0.78
    },
    "pause": {
      "items": ["resume", "controls", "settings", "title"]
    },
    "controls": [
      {
        "actions": ["left", "right"],
        "label": "Walk"
      },
      {
        "actions": ["attack"],
        "label": "Run (hold)"
      },
      {
        "actions": ["jump"],
        "label": "Jump (hold for higher)"
      }
    ],
    "levels": {
      "heading": "Pick a level",
      "mark": "*"
    },
    "clear": {
      "heading": "Level clear!",
      "lines": [
        {
          "label": "Coins",
          "status": "coins"
        },
        {
          "label": "Time",
          "status": "time",
          "format": "time"
        },
        {
          "label": "Deaths",
          "status": "deaths"
        }
      ]
    },
    "end": {
      "heading": "Hopper's Way cleared!",
      "credits": "Burrlock is beaten and the meadow is safe. Thanks for playing!",
      "lines": [
        {
          "label": "Coins",
          "status": "coins"
        },
        {
          "label": "Time",
          "status": "time",
          "format": "time"
        },
        {
          "label": "Deaths",
          "status": "deaths"
        }
      ],
      "items": ["title", "levels"]
    }
  },
  "headless": "headless.ts",
  "view": "view.ts"
}

{
  "id": "platformer",
  "title": "The platformer sample, Hopper's Way: the flagship platformer (Engine 0.16 part B), three levels and a mini-boss on the platformer kit, in 2D and 2.5D",
  "kit": "platformer",
  "content": {
    "level": ["content/levels/*.json"],
    "campaign": ["content/campaigns/*.campaign.json"],
    "profile": ["content/profiles/*.profile.json"],
    "palette": ["content/palettes/*.json"],
    "sprite": ["content/sprites/*.txt"],
    "skin": ["content/skins/*.json"],
    "sfx": ["content/sfx/*.json"],
    "song": ["content/songs/*.json"],
    "font": ["content/fonts/*.txt"]
  },
  "start": { "seed": 1 },
  "screen": { "width": 320, "height": 180 },
  "transitions": {
    "level": { "kind": "fade", "ticks": 20, "hold": 6 }
  },
  "menus": {
    "font": "hopper-small",
    "titleFont": "hopper-title",
    "style": {
      "text": "#fcfcfc",
      "shadow": "#000000",
      "focusText": "#fcd800",
      "disabledText": "#a4a4a4",
      "back": "#0c0c1c",
      "focusBack": "#0058f8",
      "border": "#fcfcfc",
      "track": "#3c3c3c",
      "fill": "#00a800",
      "padding": 6,
      "gap": 3,
      "sounds": { "move": "ui-move", "select": "ui-select", "back": "ui-back" },
      "heading": "#fcd800",
      "outline": "#000000",
      "dim": 0.5
    },
    "title": {
      "name": "Hopper's Way",
      "subtitle": "Three levels and a boss in the long meadow",
      "art": [
        { "sheet": "hopper", "frame": "runner-jump", "scale": 3, "anchor": "left", "x": 36, "y": -4 },
        { "sheet": "hopper", "frame": "walker-0", "scale": 3, "anchor": "right", "x": 36, "y": 6 }
      ],
      "music": "meadow",
      "footer": "An original game made with the Worlds Within engine",
      "items": ["start", "controls", "settings"]
    },
    "pause": { "items": ["resume", "controls", "settings", "title"] },
    "controls": [
      { "actions": ["left", "right"], "label": "Walk" },
      { "actions": ["attack"], "label": "Run (hold)" },
      { "actions": ["jump"], "label": "Jump (hold for higher)" }
    ]
  },
  "headless": "headless.ts",
  "view": "view.ts"
}

{
  "id": "platformer",
  "title": "The platformer sample: Hopper's Way, five levels and two doors on the platformer kit, in 2D and 3D",
  "kit": "platformer",
  "uses": ["topdown"],
  "kitOptions": {
    "topdown": {
      "rooms": "separate"
    }
  },
  "content": {
    "level": ["content/levels/*.json"],
    "campaign": ["content/campaigns/*.campaign.json"],
    "profile": ["content/profiles/*.profile.json"],
    "room": ["content/rooms/*.json"],
    "palette": ["content/palettes/*.json"],
    "sprite": ["content/sprites/*.txt"],
    "skin": ["content/skins/*.json"],
    "sfx": ["content/sfx/*.json"],
    "song": ["content/songs/*.json"]
  },
  "start": {
    "seed": 1
  },
  "screen": {
    "width": 256,
    "height": 240
  },
  "transitions": {
    "level": {
      "kind": "fade",
      "ticks": 20,
      "hold": 6
    },
    "scene": {
      "kind": "iris",
      "ticks": 20,
      "hold": 4,
      "ease": "quadIn",
      "at": "follow"
    }
  },
  "headless": "headless.ts",
  "view": "view.ts"
}

{
  "backend": "canvas2d",
  "background": "#000000",
  "sheets": { "sheet": "dungeon", "fallbackColor": "#f878f8" },
  "camera": { "clamp": false },
  "kinds": {
    "hero": {
      "sheet": "hero",
      "frames": {
        "walk": {
          "down": { "frames": ["down-0", "down-1"], "ticks": 8 },
          "up": { "frames": ["up-0", "up-1"], "ticks": 8 },
          "right": { "frames": ["side-0", "side-1"], "ticks": 8 }
        },
        "attack": { "down": "attack-down", "up": "attack-up", "right": "attack-side" },
        "throw": { "down": "throw-down", "up": "throw-up", "right": "throw-side" },
        "hold": "hold",
        "hurt": { "down": "down-0", "up": "up-0", "right": "side-0" },
        "dying": { "frames": ["down-0", "side-0", "up-0", "side-0"], "ticks": 4 },
        "poof": { "frames": ["poof-0", "poof-1", "poof-2"], "ticks": 8 }
      },
      "flipFacing": true
    },
    "held": {
      "frames": {
        "heart-pickup": "heart-pickup",
        "key": "key",
        "bomb-pickup": "bomb-pickup",
        "refill-icon": "refill",
        "map": "map",
        "compass": "compass",
        "triforce": "triforce",
        "heart-container": "heart-container",
        "bomb-icon": "bomb-icon",
        "boomerang-icon": "boomerang-icon",
        "white-sword-icon": "sword-icon",
        "idle": "bomb-icon"
      }
    },
    "sword": {
      "sheet": "dungeon",
      "frames": { "stab": { "down": "sword-v", "up": "sword-v", "right": "sword-h", "left": "sword-h" } }
    },
    "poof": { "frames": { "poof": { "frames": ["poof-0", "poof-1", "poof-2"], "ticks": 6 } } },
    "pickup:heart": { "frames": { "idle": "heart-pickup" } },
    "pickup:key": { "frames": { "idle": "key" } },
    "pickup:bombs": { "frames": { "idle": "bomb-pickup" } },
    "pickup:map": { "frames": { "idle": "map" } },
    "pickup:compass": { "frames": { "idle": "compass" } },
    "pickup:triforce": { "frames": { "idle": "triforce" } },
    "pickup:heart-container": { "frames": { "idle": "heart-container" } },
    "pickup:refill": { "frames": { "idle": "refill" } },
    "pickup:bomb": { "frames": { "idle": "bomb-icon" } },
    "pickup:boomerang": { "frames": { "idle": "boomerang-icon" } },
    "pickup:white-sword": { "frames": { "idle": "sword-icon" } },
    "chest": { "frames": { "closed": "chest", "open": "chest-open" } },
    "push-block": { "frames": { "idle": "push-block" } },
    "switch": { "frames": { "up": "switch-up", "down": "switch-down" } },
    "torch": {
      "frames": { "off": "torch-off", "lit": { "frames": ["torch-lit-0", "torch-lit-1"], "ticks": 8 } }
    },
    "bat": { "frames": { "rest": "bat-0", "fly": { "frames": ["bat-0", "bat-1"], "ticks": 4 } } },
    "knight": {
      "frames": {
        "walk": {
          "down": { "frames": ["knight-down-0", "knight-down-1"], "ticks": 8 },
          "up": { "frames": ["knight-up-0", "knight-up-1"], "ticks": 8 },
          "right": { "frames": ["knight-side-0", "knight-side-1"], "ticks": 8 }
        }
      },
      "flipFacing": true
    },
    "spitter": {
      "frames": {
        "walk": {
          "down": { "frames": ["spitter-down-0", "spitter-down-1"], "ticks": 8 },
          "up": { "frames": ["spitter-up-0", "spitter-up-1"], "ticks": 8 },
          "right": { "frames": ["spitter-side-0", "spitter-side-1"], "ticks": 8 }
        },
        "spit": { "down": "spitter-down-0", "up": "spitter-up-0", "right": "spitter-side-0" }
      },
      "flipFacing": true
    },
    "rock": { "frames": { "fly": "rock" } },
    "stun": { "frames": { "spin": "stun" } },
    "boomerang": {
      "frames": {
        "spin": { "frames": ["boomerang-0", "boomerang-1", "boomerang-2", "boomerang-3"], "ticks": 4 }
      }
    },
    "bomb": {
      "frames": {
        "fuse": { "frames": ["bomb-0", "bomb-1"], "ticks": 8 },
        "fuse-short": { "frames": ["bomb-0", "bomb-1"], "ticks": 4 }
      }
    },
    "explosion": { "frames": { "blast": { "frames": ["blast-0", "blast-1", "blast-2"], "ticks": 8 } } },
    "sword-beam": {
      "frames": {
        "fly": {
          "down": { "frames": ["beam-v-0", "beam-v-1"], "ticks": 2 },
          "up": { "frames": ["beam-v-0", "beam-v-1"], "ticks": 2 },
          "right": { "frames": ["beam-h-0", "beam-h-1"], "ticks": 2 },
          "left": { "frames": ["beam-h-0", "beam-h-1"], "ticks": 2 }
        }
      }
    },
    "beam-shard": { "frames": { "fly": "beam-shard" } }
  },
  "tiles": {
    "#": { "frame": "wall" },
    ".": { "frame": "floor" },
    ":": { "frame": "floor-alt" },
    "B": { "frame": "block" },
    "S": { "frame": "statue" },
    "~": { "frame": "water" },
    "=": { "frame": "stairs" },
    "E": { "frame": "exit" },
    "O": { "frame": "door-open" },
    "L": { "frame": "door-locked" },
    "X": { "frame": "door-shut" },
    "C": { "frame": "wall-cracked" },
    "H": { "frame": "wall-hole" },
    "D": { "frame": "door-boarded" },
    "d": { "frame": "door-closed" }
  },
  "events": {
    "room": { "sound": "door" },
    "unlock": { "sound": "unlock" },
    "spit": { "sound": "spit" },
    "hurt": { "sound": "hurt" },
    "hit": { "sound": "hit" },
    "sword": { "sound": "sword" },
    "pickup": { "sound": "pickup" },
    "chest": { "sound": "chest" },
    "bomb": { "sound": "fuse" },
    "kill": {
      "sound": "kill",
      "effect": { "kind": "particles", "color": "#fcfcfc", "count": 6, "size": 2, "ticks": 12 }
    },
    "blast": { "sound": "blast", "effect": { "kind": "shake", "size": 2, "ticks": 8 } },
    "dying": { "sound": "fall" },
    "exit": { "sound": "fanfare", "effect": { "kind": "flash", "color": "#f8d878", "ticks": 12 } }
  },
  "hud": [
    { "status": "hp", "as": "hearts", "x": 8, "y": 52, "frame": "hud-half-heart" },
    { "status": "keys", "as": "hearts", "x": 48, "y": 52, "frame": "hud-key" },
    { "status": "item", "as": "icon", "x": 88, "y": 52, "frame": "hud-item" }
  ]
}

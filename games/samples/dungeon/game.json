{
  "id": "dungeon",
  "title": "The dungeon sample: The Old Crypt, five rooms and a way out on the top-down kit",
  "kit": "topdown",
  "content": {
    "room": ["content/rooms/*.json"],
    "song": ["content/songs/*.json"],
    "palette": ["content/palettes/*.json"],
    "sprite": ["content/sprites/*.txt"],
    "sfx": ["content/sfx/*.json"],
    "skin": ["content/skins/*.json"],
    "font": ["content/fonts/*.txt"]
  },
  "start": { "seed": 1 },
  "screen": { "width": 256, "height": 240 },
  "menus": {
    "font": "crypt-small",
    "titleFont": "crypt-title",
    "style": {
      "text": "#fcfcfc",
      "shadow": "#000000",
      "focusText": "#fca044",
      "disabledText": "#a4a4a4",
      "back": "#0c0c1c",
      "focusBack": "#6c0000",
      "border": "#fcfcfc",
      "track": "#3c3c3c",
      "fill": "#d82800",
      "padding": 6,
      "gap": 3,
      "sounds": { "move": "ui-move", "select": "ui-select", "back": "ui-back" },
      "heading": "#fca044",
      "outline": "#000000",
      "dim": 0.5
    },
    "title": {
      "name": "The Old Crypt",
      "subtitle": "Torches, keys and a relic in the dark",
      "art": [
        { "sheet": "hero", "frame": "attack-side", "scale": 3, "anchor": "left", "x": 34, "y": -4 },
        { "sheet": "dungeon", "frame": "knight-side-0", "scale": 3, "anchor": "right", "x": 34, "y": -4 }
      ],
      "music": "crypt",
      "footer": "An original game made with the Worlds Within engine",
      "items": ["start", "controls", "settings"],
      "dim": 0.85
    },
    "pause": { "items": ["resume", "controls", "settings", "title"] },
    "controls": [
      { "actions": ["left", "right", "up", "down"], "label": "Walk" },
      { "actions": ["attack"], "label": "Sword" },
      { "actions": ["special"], "label": "Use item" },
      { "actions": ["select"], "label": "Next item" }
    ]
  },
  "headless": "headless.ts",
  "view": "view.ts"
}

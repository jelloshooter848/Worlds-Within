{
  "backend": "canvas2d",
  "sheets": {
    "sheet": "td",
    "fallbackColor": "#ff00ff"
  },
  "kinds": {
    "tower:arrow": {
      "frames": {
        "idle": "arrow-idle",
        "fire": "arrow-fire"
      },
      "fallbackColor": "#7c4800"
    },
    "tower:cannon": {
      "frames": {
        "idle": "cannon-idle",
        "fire": "cannon-fire"
      },
      "fallbackColor": "#7c7c7c"
    },
    "enemy:runner": {
      "frames": {
        "walk": {
          "frames": ["runner-0", "runner-1"],
          "ticks": 8
        }
      },
      "flipFacing": true,
      "fallbackColor": "#00e800",
      "byTag": [
        {
          "tag": "hit",
          "palette": "td-hit"
        }
      ]
    },
    "enemy:brute": {
      "frames": {
        "walk": {
          "frames": ["brute-0", "brute-1"],
          "ticks": 8
        }
      },
      "flipFacing": true,
      "fallbackColor": "#6844fc",
      "byTag": [
        {
          "tag": "hit",
          "palette": "td-hit"
        }
      ]
    },
    "shot:arrow": {
      "frames": {
        "idle": "shot-arrow"
      },
      "fallbackColor": "#bcbcbc"
    },
    "shot:cannon": {
      "frames": {
        "idle": "shot-cannon"
      },
      "fallbackColor": "#f8b800"
    },
    "ghost:arrow": {
      "frames": {
        "idle": "arrow-idle"
      },
      "fallbackColor": "#b8f818",
      "byTag": [
        {
          "tag": "ok",
          "palette": "td-ok"
        },
        {
          "tag": "blocked",
          "palette": "td-blocked",
          "fallbackColor": "#f83800"
        }
      ]
    },
    "ghost:cannon": {
      "frames": {
        "idle": "cannon-idle"
      },
      "fallbackColor": "#b8f818",
      "byTag": [
        {
          "tag": "ok",
          "palette": "td-ok"
        },
        {
          "tag": "blocked",
          "palette": "td-blocked",
          "fallbackColor": "#f83800"
        }
      ]
    },
    "cursor": {
      "frames": {
        "idle": {
          "frames": ["cursor-0", "cursor-1"],
          "ticks": 16
        }
      },
      "fallbackColor": "#fcfcfc"
    }
  },
  "tiles": {
    ".": {
      "frame": "ground",
      "fallbackColor": "#00a800"
    },
    "#": {
      "frame": "road",
      "fallbackColor": "#c84c0c"
    },
    "B": {
      "frame": "pad",
      "fallbackColor": "#7c7c7c"
    },
    "S": {
      "frame": "cave",
      "fallbackColor": "#000000"
    },
    "X": {
      "frame": "gate",
      "fallbackColor": "#bcbcbc"
    }
  },
  "events": {
    "td-place": {
      "sound": "place",
      "effect": {
        "kind": "particles",
        "color": "#fcfcfc",
        "count": 6,
        "size": 1,
        "ticks": 8
      }
    },
    "td-sell": {

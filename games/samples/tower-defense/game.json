{
  "id": "tower-defense",
  "title": "Tower defense: hold the winding road against ten waves",
  "kit": "towerdefense",
  "content": {
    "td-map": ["content/maps/*.json"],
    "td-towers": ["content/towers/*.json"],
    "td-waves": ["content/waves/*.json"],
    "palette": ["content/palettes/*.json"],
    "sprite": ["content/sprites/*.txt"],
    "skin": ["content/skins/*.json"],
    "sfx": ["content/sfx/*.json"],
    "song": ["content/songs/*.json"],
    "font": ["content/fonts/*.txt"]
  },
  "start": { "seed": 12 },
  "screen": { "width": 480, "height": 270 },
  "menus": {
    "font": "road-small",
    "titleFont": "road-title",
    "style": {
      "text": "#fcfcfc",
      "shadow": "#000000",
      "focusText": "#fcd800",
      "disabledText": "#a4a4a4",
      "back": "#0c0c1c",
      "focusBack": "#00502c",
      "border": "#fcfcfc",
      "track": "#3c3c3c",
      "fill": "#58d854",
      "padding": 6,
      "gap": 3,
      "sounds": { "move": "ui-move", "select": "ui-select", "back": "ui-back" },
      "heading": "#fcd800",
      "outline": "#000000",
      "dim": 0.5
    },
    "title": {
      "name": "The Winding Road",
      "subtitle": "Build on the stones, keep the gate shut",
      "art": [
        { "sheet": "road", "frame": "arrow-3", "scale": 2, "anchor": "left", "x": 96, "y": -4 },
        { "sheet": "road", "frame": "cannon-3", "scale": 2, "anchor": "right", "x": 96, "y": -4 }
      ],
      "music": "road",
      "footer": "An original game made with the Worlds Within engine",
      "items": ["start", "controls", "settings"],
      "dim": 0.6
    },
    "pause": { "items": ["resume", "controls", "settings", "title"] },
    "controls": [
      { "actions": ["left", "right", "up", "down"], "tap": "a tap", "label": "Move" },
      { "actions": ["jump"], "tap": "tap again", "label": "Build" },
      { "actions": ["jump"], "tap": "tap a tower twice", "label": "Upgrade" },
      { "actions": ["attack"], "label": "Next tower" },
      { "actions": ["special"], "tap": "right click", "label": "Sell" },
      { "actions": ["start"], "label": "Send the wave" },
      { "tap": "F or the speed button", "label": "Speed" }
    ],
    "speeds": [1, 2, 3]
  },
  "headless": "headless.ts",
  "view": "view.ts"
}

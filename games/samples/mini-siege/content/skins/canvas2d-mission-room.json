  "sheets": {
    "sheet": "dungeon",
    "fallbackColor": "#fcfcfc"
  },
  "camera": {
    "clamp": false
  },
  "kinds": {
    "hero": {
      "frames": {
        "idle": {
          "frames": ["knight_m_idle_f0", "knight_m_idle_f1", "knight_m_idle_f2", "knight_m_idle_f3"],
          "ticks": 8
        },
        "walk": {
          "frames": ["knight_m_run_f0", "knight_m_run_f1", "knight_m_run_f2", "knight_m_run_f3"],
          "ticks": 5,
          "events": {
            "1": "footstep",
            "3": "footstep"
          }
        },
        "attack": {
          "frames": ["knight_m_run_f2", "knight_m_idle_f0"],
          "ticks": [3, 20],
          "loop": false
        },
        "hurt": "knight_m_hit_f0",
        "dying": {
          "frames": ["knight_m_hit_f0", "knight_m_idle_f0"],
          "ticks": 3
        },
        "poof": {
          "sheet": "camp",
          "frames": ["poof-0", "poof-1", "poof-2"],
          "ticks": 8,
          "loop": false
        }
      },
      "flipFacing": true,
      "hitFlash": {
        "tag": "flashing",
        "color": "#ffffff",
        "blink": 3
      },
      "fallbackColor": "#0058f8"
    },
    "sword": {
      "frames": {
        "stab": "weapon_regular_sword"
      },
      "turnToFacing": "up",
      "spawnTween": {
        "prop": "scale",
        "from": 0.6,
        "to": 1,
        "frames": 4,
        "ease": "backOut"
      },
      "fallbackColor": "#fcfcfc"
    },
    "poof": {
      "sheet": "camp",
      "emit": ["embers", "smoke"],
      "frames": {
        "poof": {
          "frames": ["poof-0", "poof-1", "poof-2"],
          "ticks": 6,
          "loop": false
        }
      },
      "fallbackColor": "#f83800"
    },
    "knight": {
      "frames": {
        "walk": {
          "frames": ["orc_warrior_run_f0", "orc_warrior_run_f1", "orc_warrior_run_f2", "orc_warrior_run_f3"],
          "ticks": 7
        },
        "idle": {
          "frames": [
            "orc_warrior_idle_f0",
            "orc_warrior_idle_f1",
            "orc_warrior_idle_f2",
            "orc_warrior_idle_f3"
          ],
          "ticks": 8
        }
      },
      "flipFacing": true,
      "hitFlash": {
        "tag": "flashing",
        "color": "#ffffff",
        "blink": 2
      },
      "fallbackColor": "#a80020",
      "byTag": [
        {
          "tag": "foe:ram",
          "sheet": "camp",
          "frames": {
            "walk": {
              "right": {
                "frames": ["ram-0", "ram-1"],
                "ticks": 8
              }
            }
          }
        },
        {
          "tag": "foe:catapult",
          "sheet": "camp",
          "frames": {
            "walk": {
              "right": {
                "frames": ["catapult-0", "catapult-1"],
                "ticks": 8
              }
            }
          }
        },
        {
          "tag": "foe:28",
          "frames": {
            "walk": {
              "frames": ["masked_orc_run_f0", "masked_orc_run_f1", "masked_orc_run_f2", "masked_orc_run_f3"],
              "ticks": 7
            },
            "idle": {
              "frames": [
                "masked_orc_idle_f0",
                "masked_orc_idle_f1",
                "masked_orc_idle_f2",
                "masked_orc_idle_f3"
              ],
              "ticks": 8
            }
          }
        },
        {
          "tag": "foe:15",
          "frames": {
            "walk": {
              "frames": ["masked_orc_run_f0", "masked_orc_run_f1", "masked_orc_run_f2", "masked_orc_run_f3"],
              "ticks": 7
            },
            "idle": {
              "frames": [
                "masked_orc_idle_f0",
                "masked_orc_idle_f1",
                "masked_orc_idle_f2",
                "masked_orc_idle_f3"
              ],
              "ticks": 8
            }
          }
        }
      ]
    },
    "pickup:heart": {
      "frames": {
        "idle": "ui_heart_full"
      },
      "spawnTween": {
        "prop": "y",
        "from": -2,
        "to": 0,
        "frames": 20,
        "ease": "sineInOut",
        "yoyo": true,
        "repeat": "forever"
      },
      "fallbackColor": "#f83800"
    }
  },
  "tiles": {
    "#": {
      "frame": "wall_mid",
      "join": {
        "edge": "join",
        "frames": {
          "top": "wall_capped",
          "top right": "wall_capped",
          "top bottom": "wall_capped",
          "top left": "wall_capped",
          "top right bottom": "wall_capped",
          "top right left": "wall_capped",
          "top bottom left": "wall_capped",
          "top right bottom left": "wall_capped"
        }
      },
      "fallbackColor": "#3c3040"
    },
    ".": {
      "frame": "floor_1",
      "fallbackColor": "#3c3040"
    }
  },
  "emitters": {
    "dust": {
      "burst": 2,
      "life": [10, 16],
      "speed": [0.15, 0.4],
      "angle": [200, 340],
      "anchor": "feet",
      "shape": {
        "box": {
          "w": 6,
          "h": 1
        }
      },
      "gravity": -0.01,
      "drag": 0.06,
      "size": [2, 1],
      "color": ["#8c7c70", "#5c5058"],
      "alpha": [0.8, 0]
    },
    "slash": {
      "burst": 6,
      "life": [6, 10],
      "speed": [0.8, 1.6],
      "angle": [0, 360],
      "drag": 0.15,
      "size": [2, 1],
      "color": ["#ffffff", "#c8e0ff"],
      "alpha": [1, 0],
      "blend": "add"
    },
    "blood": {
      "burst": 10,
      "life": [10, 18],
      "speed": [0.6, 1.6],
      "angle": [0, 360],
      "drag": 0.1,
      "gravity": 0.06,
      "size": [2, 1],
      "color": ["#f83800", "#a80020"],
      "alpha": [1, 0]
    },
    "embers": {
      "rate": 1.2,
      "life": [14, 26],
      "speed": [0.3, 0.9],
      "angle": [240, 300],
      "shape": {
        "circle": 6
      },
      "gravity": -0.02,
      "size": [2, 1],
      "color": ["#fce0a8", "#f8b800", "#f83800"],
      "alpha": [1, 0],
      "blend": "add"
    },
    "smoke": {
      "rate": 0.5,
      "life": [20, 34],
      "speed": [0.2, 0.5],
      "angle": [250, 290],
      "shape": {
        "circle": 5
      },
      "gravity": -0.01,
      "size": [3, 5],
      "color": ["#5c5058", "#2c2830"],
      "alpha": [0.7, 0]
    }
  },
  "events": {
    "footstep": {
      "emit": "dust"
    },
    "sword": {
      "sound": "sword",
      "pitch": [-1, 1],
      "emit": "slash",
      "tween": [
        {
          "prop": "scaleX",
          "from": 1.25,
          "to": 1,
          "frames": 6,
          "ease": "quadOut"
        }
      ]
    },
    "hit": {
      "shake": {
        "amount": 1.5,
        "ticks": 6
      },
      "hitPause": {
        "ticks": 3
      }
    },
    "kill": {
      "sound": "burn",
      "shake": {
        "amount": 3,
        "ticks": 10
      },
      "hitPause": {
        "ticks": 5
      },
      "zoom": {
        "to": 1.05,
        "ticks": 10,
        "ease": "quadOut"
      }
    },
    "hurt": {
      "sound": "hurt",
      "emit": "blood",
      "shake": {
        "amount": 3,
        "ticks": 10
      },
      "hitPause": {
        "ticks": 4
      },
      "flash": {
        "color": "#a80020",
        "alpha": 0.35,
        "ticks": 6
      }
    },
    "dying": {
      "sound": "fail",
      "shake": {
        "amount": 2,
        "ticks": 12
      }
    },
    "dead": {
      "effect": {
        "kind": "tint",
        "color": "#a80020",
        "ticks": 10
      }
    }
  },

{
  "name": "worlds-within",
  "version": "0.0.0",
  "private": true,
  "description": "Worlds Within: one persistent world played through many genres, and the engine that makes it.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "cli": "tsx engine/tools/cli.ts",
    "bench:features": "tsx tests/bench/feature-render/run.ts",
    "docs:gen": "tsx engine/tools/docs.ts gen",
    "docs:check": "tsx engine/tools/docs.ts check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "0.187.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  }
}
